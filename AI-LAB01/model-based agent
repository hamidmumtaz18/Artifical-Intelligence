        "\n",
        "import random\n",
        "\n",
        "class ModelBasedVacuumAgent:\n",
        "    def __init__(self):\n",
        "        self.model = {}\n",
        "\n",
        "    def act(self, location, dirty):\n",
        "        # Remember the current room's condition\n",
        "        self.model[location] = dirty\n",
        "\n",
        "        # Clean if the current room is dirty\n",
        "        if dirty == 1:\n",
        "            return \"Suck\"\n",
        "\n",
        "        # Stop when both rooms are known to be clean\n",
        "        if (self.model.get('A') == 0 and\n",
        "                self.model.get('B') == 0):\n",
        "            return \"NoOp\"\n",
        "\n",
        "        # Visit the other room\n",
        "        if location == 'A':\n",
        "            return \"Right\"\n",
        "        else:\n",
        "            return \"Left\"\n",
        "\n",
        "\n",
        "def run_model_based(seed):\n",
        "    rng = random.Random(seed)\n",
        "\n",
        "    rooms = {\n",
        "        'A': rng.randint(0, 1),\n",
        "        'B': rng.randint(0, 1)\n",
        "    }\n",
        "    location = rng.choice(['A', 'B'])\n",
        "\n",
        "    agent = ModelBasedVacuumAgent()\n",
        "    score = 0\n",
        "    moves = 0\n",
        "    cleaned = 0\n",
        "\n",
        "    for _ in range(20):\n",
        "        action = agent.act(location, rooms[location])\n",
        "\n",
        "        if action == \"NoOp\":\n",
        "            break\n",
        "\n",
        "        if action == \"Suck\":\n",
        "            if rooms[location] == 1:\n",
        "                rooms[location] = 0\n",
        "                score += 10\n",
        "                cleaned += 1\n",
        "\n",
        "        elif action == \"Left\":\n",
        "            location = 'A'\n",
        "            score -= 1\n",
        "            moves += 1\n",
        "\n",
        "        elif action == \"Right\":\n",
        "            location = 'B'\n",
        "            score -= 1\n",
        "            moves += 1\n",
        "\n",
        "    return score, moves, cleaned\n",
        "\n",
        "\n",
        "# Compare the agents on the same 10 initial states\n",
        "simple_scores = [\n",
        "    run_agent(seed, \"Reflex\", 20)\n",
        "    for seed in range(10)\n",
        "]\n",
        "\n",
        "model_results = [\n",
        "    run_model_based(seed)\n",
        "    for seed in range(10)\n",
        "]\n",
        "\n",
        "model_scores = [result[0] for result in model_results]\n",
        "\n",
        "print(\"Simple reflex average:\",\n",
        "      sum(simple_scores) / len(simple_scores))\n",
        "\n",
        "print(\"Model-based average:\",\n",
        "      sum(model_scores) / len(model_scores))\n",
        "\n",
        "print(\"Model-based scores:\", model_scores)\n",
        "\n",
        "print(\"Total model-based moves:\",\n",
        "      sum(result[1] for result in model_results))\n",
        "\n",
        "print(\"Total rooms cleaned:\",\n",
        "      sum(result[2] for result in model_results))\n"
      ]
    }
