      "source": [
        "\n",
        "import random\n",
        "import statistics\n",
        "\n",
        "\n",
        "def run_agent(seed, agent_type, steps=20):\n",
        "    rng = random.Random(seed)\n",
        "\n",
        "    # Generate random initial state\n",
        "    rooms = {\n",
        "        'A': rng.randint(0, 1),\n",
        "        'B': rng.randint(0, 1)\n",
        "    }\n",
        "\n",
        "    location = rng.choice(['A', 'B'])\n",
        "    score = 0\n",
        "\n",
        "    for _ in range(steps):\n",
        "\n",
        "        # Choose an action\n",
        "        if agent_type == \"Random\":\n",
        "            action = rng.choice(['Left', 'Right', 'Suck'])\n",
        "\n",
        "        elif agent_type == \"Reflex\":\n",
        "            if rooms[location] == 1:\n",
        "                action = 'Suck'\n",
        "            elif location == 'A':\n",
        "                action = 'Right'\n",
        "            else:\n",
        "                action = 'Left'\n",
        "\n",
        "        else:\n",
        "            raise ValueError(\"Invalid agent type\")\n",
        "\n",
        "        # Execute action and calculate score\n",
        "        if action == 'Suck':\n",
        "            if rooms[location] == 1:\n",
        "                score += 10\n",
        "                rooms[location] = 0\n",
        "\n",
        "        elif action == 'Left':\n",
        "            location = 'A'\n",
        "            score -= 1\n",
        "\n",
        "        elif action == 'Right':\n",
        "            location = 'B'\n",
        "            score -= 1\n",
        "\n",
        "    return score\n",
        "\n",
        "\n",
        "# Store agent scores\n",
        "random_scores = []\n",
        "reflex_scores = []\n",
        "\n",
        "# Test on 10 random initial states\n",
        "for seed in range(10):\n",
        "    random_scores.append(\n",
        "        run_agent(seed, \"Random\", 20)\n",
        "    )\n",
        "\n",
        "    reflex_scores.append(\n",
        "        run_agent(seed, \"Reflex\", 20)\n",
        "    )\n",
        "\n",
        "# Display results\n",
        "print(\"Random agent scores:\", random_scores)\n",
        "print(\"Reflex agent scores:\", reflex_scores)\n",
        "\n",
        "print(\"Random agent average:\",\n",
        "      statistics.mean(random_scores))\n",
        "\n",
        "print(\"Reflex agent average:\",\n",
        "      statistics.mean(reflex_scores))\n"
      ]
    }
